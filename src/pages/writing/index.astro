---
import { getCollection } from "astro:content";
import Base from "../../layouts/Base.astro";

const writing = (await getCollection("writing")).sort(
  (a, b) => a.data.order - b.data.order,
);
---

<Base title="Writing — Gioia Zheng" description="Technical notes on retrieval, generation, evaluation, and reproducibility.">
  <h1>Writing</h1>
  <p class="tagline">
    Short technical notes. Drafts and planned topics are marked as such — nothing
    here is implied to be a finished paper.
  </p>

  <ul class="entry-list">
    {
      writing.map((w) => (
        <li>
          <div class="entry-title">
            <a href={`/writing/${w.slug}/`}>{w.data.title}</a>
            <span class="badge" style="margin-left: 0.5rem;">{w.data.status}</span>
          </div>
          <div class="entry-summary">{w.data.summary}</div>
          {w.data.date && <div class="entry-meta">{w.data.date}</div>}
        </li>
      ))
    }
  </ul>
</Base>
