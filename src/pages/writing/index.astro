---
import { getCollection } from "astro:content";
import Base from "../../layouts/Base.astro";
import { entrySlug } from "../../lib/content";

const all = await getCollection("writing");
const byOrderThenDate = (a, b) =>
  a.data.order - b.data.order ||
  (b.data.date ?? "").localeCompare(a.data.date ?? "");
const published = all
  .filter((w) => w.data.status === "published")
  .sort(byOrderThenDate);
const drafts = all
  .filter((w) => w.data.status === "draft")
  .sort(byOrderThenDate);
---

<Base
  title="Writing — Gioia Zheng"
  description="Short technical notes on retrieval, generation, agent evaluation, and failure analysis."
  width="wide"
>
  <div class="page-header">
    <h1>Writing</h1>
    <p class="page-tagline">
      Short technical notes. New notes land alongside the experimental round
      that produced them.
    </p>
  </div>

  {
    published.length > 0 && (
      <section class="section">
        <div class="kicker">
          <span>Published</span>
          <span>{published.length} note{published.length > 1 ? "s" : ""}</span>
        </div>
        <div class="note-list">
          {published.map((w) => (
            <a href={`/writing/${entrySlug(w)}/`} class="note-link">
              {w.data.title}
            </a>
          ))}
        </div>
      </section>
    )
  }

  {
    drafts.length > 0 && (
      <section class="section">
        <div class="kicker">
          <span>Drafts in progress</span>
        </div>
        <div class="note-list">
          {drafts.map((w) => (
            <a href={`/writing/${entrySlug(w)}/`} class="note-link is-draft">
              {w.data.title}
            </a>
          ))}
        </div>
      </section>
    )
  }
</Base>
