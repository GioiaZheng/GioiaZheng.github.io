---
import { getCollection } from "astro:content";
import Base from "../../layouts/Base.astro";

const all = await getCollection("writing");
const published = all
  .filter((w) => w.data.status === "published")
  .sort((a, b) => (b.data.date ?? "").localeCompare(a.data.date ?? ""));
const drafts = all
  .filter((w) => w.data.status === "draft")
  .sort((a, b) => a.data.order - b.data.order);
---

<Base
  title="Writing — Gioia Zheng"
  description="Short technical notes on retrieval, generation, and evaluation."
  width="medium"
>
  <div class="page-header">
    <h1>Writing</h1>
    <p class="page-tagline">
      Short technical notes. New notes land alongside the experimental round
      that produced them.
    </p>
  </div>

  <div class="card-grid">
    {
      published.map((w) => (
        <a href={`/writing/${w.slug}/`} class="card">
          <div class="card-head">
            <div class="card-title">{w.data.title}</div>
            {w.data.date && <span class="badge" data-status="published">{w.data.date}</span>}
          </div>
          <p class="card-summary">{w.data.summary}</p>
        </a>
      ))
    }
  </div>

  {
    drafts.length > 0 && (
      <>
        <h2>Drafts in progress</h2>
        <div class="card-grid">
          {drafts.map((w) => (
            <a href={`/writing/${w.slug}/`} class="card">
              <div class="card-head">
                <div class="card-title">{w.data.title}</div>
                <span class="badge" data-status="draft">draft</span>
              </div>
              <p class="card-summary">{w.data.summary}</p>
            </a>
          ))}
        </div>
      </>
    )
  }
</Base>
