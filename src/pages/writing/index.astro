---
import { getCollection } from "astro:content";
import Base from "../../layouts/Base.astro";
import { entrySlug } from "../../lib/content";

const all = await getCollection("writing");
const published = all
  .filter((w) => w.data.status === "published")
  .sort((a, b) => (b.data.date ?? "").localeCompare(a.data.date ?? ""));
const drafts = all
  .filter((w) => w.data.status === "draft")
  .sort((a, b) => a.data.order - b.data.order);
---

<Base
  title="Writing — Gioia Zheng"
  description="Short technical notes on retrieval, generation, and evaluation."
  width="wide"
>
  <div class="page-header">
    <h1>Writing</h1>
    <p class="page-tagline">
      Short technical notes. New notes land alongside the experimental round
      that produced them.
    </p>
  </div>

  {
    published.length > 0 && (
      <section class="section">
        <div class="kicker">
          <span>Published</span>
          <span>{published.length} note{published.length > 1 ? "s" : ""}</span>
        </div>
        <div class="card-grid">
          {published.map((w) => (
            <a href={`/writing/${entrySlug(w)}/`} class="card">
              <div class="card-head">
                <div class="card-title">{w.data.title}</div>
                {w.data.date && (
                  <span class="badge" data-status="published">{w.data.date}</span>
                )}
              </div>
              <p class="card-summary">{w.data.summary}</p>
              <div class="card-action">Read note</div>
            </a>
          ))}
        </div>
      </section>
    )
  }

  {
    drafts.length > 0 && (
      <section class="section">
        <div class="kicker">
          <span>Drafts in progress</span>
        </div>
        <div class="card-grid">
          {drafts.map((w) => (
            <a href={`/writing/${entrySlug(w)}/`} class="card">
              <div class="card-head">
                <div class="card-title">{w.data.title}</div>
                <span class="badge" data-status="draft">draft</span>
              </div>
              <p class="card-summary">{w.data.summary}</p>
            </a>
          ))}
        </div>
      </section>
    )
  }
</Base>
