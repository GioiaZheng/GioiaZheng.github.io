---
import { getCollection } from "astro:content";
import Base from "../../layouts/Base.astro";

export async function getStaticPaths() {
  const writing = await getCollection("writing");
  return writing.map((w) => ({
    params: { slug: w.slug },
    props: { entry: w },
  }));
}

const { entry } = Astro.props;
const { Content } = await entry.render();
---

<Base title={`${entry.data.title} — Gioia Zheng`} description={entry.data.summary}>
  <p class="entry-meta"><a href="/writing/">&larr; All writing</a></p>
  <h1>{entry.data.title}</h1>
  <p class="entry-meta">
    <span class="badge">{entry.data.status}</span>
    {entry.data.date}
  </p>
  <p class="tagline">{entry.data.summary}</p>
  <Content />
</Base>
