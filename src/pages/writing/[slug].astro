---
import { getCollection } from "astro:content";
import Base from "../../layouts/Base.astro";

export async function getStaticPaths() {
  const writing = await getCollection("writing");
  return writing.map((w) => ({
    params: { slug: w.slug },
    props: { entry: w },
  }));
}

const { entry } = Astro.props;
const { Content } = await entry.render();
---

<Base
  title={`${entry.data.title} — Gioia Zheng`}
  description={entry.data.summary}
  width="text"
>
  <p class="page-crumb"><a href="/writing/">← Writing</a></p>

  <header class="page-header">
    <h1>{entry.data.title}</h1>
    <p class="page-tagline">{entry.data.summary}</p>
    <div class="page-meta">
      <span class="badge" data-status={entry.data.status}>{entry.data.status}</span>
      {entry.data.date && <span>· {entry.data.date}</span>}
    </div>
  </header>

  <article class="prose">
    <Content />
  </article>
</Base>
