---
import { getCollection } from "astro:content";
import Base from "../../layouts/Base.astro";

export async function getStaticPaths() {
  const projects = await getCollection("projects");
  return projects.map((p) => ({
    params: { slug: p.slug },
    props: { entry: p },
  }));
}

const { entry } = Astro.props;
const { Content } = await entry.render();
---

<Base title={`${entry.data.title} — Gioia Zheng`} description={entry.data.summary}>
  <p class="entry-meta"><a href="/projects/">&larr; All projects</a></p>
  <h1>{entry.data.title}</h1>
  <p class="tagline">{entry.data.summary}</p>
  <p class="entry-meta">
    <span class="badge" data-status={entry.data.status}>{entry.data.status}</span>
    {entry.data.tags.join(" · ")}
    {entry.data.last_updated && <span> &middot; updated {entry.data.last_updated}</span>}
  </p>
  <Content />
</Base>
