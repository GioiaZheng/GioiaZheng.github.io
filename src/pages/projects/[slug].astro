---
import { getCollection, render } from "astro:content";
import Base from "../../layouts/Base.astro";
import { entrySlug } from "../../lib/content";

export async function getStaticPaths() {
  const projects = await getCollection("projects");
  return projects.map((p) => ({
    params: { slug: entrySlug(p) },
    props: { entry: p },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
---

<Base
  title={`${entry.data.title} — Gioia Zheng`}
  description={entry.data.summary}
  width="wide"
>
  <p class="page-crumb"><a href="/projects/">Projects</a></p>

  <header class="page-header">
    <h1>{entry.data.title}</h1>
    <p class="page-tagline">{entry.data.summary}</p>
    <div class="page-meta">
      <span class="badge" data-status={entry.data.status}>{entry.data.status}</span>
      {entry.data.tags.length > 0 && <span>{entry.data.tags.join(" · ")}</span>}
      {entry.data.last_updated && <span>· updated {entry.data.last_updated}</span>}
      {entry.data.repo && <span>· <a href={entry.data.repo}>Repository</a></span>}
    </div>
  </header>

  <article class="prose">
    <Content />
  </article>
</Base>
