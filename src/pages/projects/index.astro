---
import { getCollection } from "astro:content";
import Base from "../../layouts/Base.astro";
import ProjectCard from "../../components/ProjectCard.astro";

const all = (await getCollection("projects")).sort(
  (a, b) => a.data.order - b.data.order,
);
const featured = all.filter((p) => p.data.featured);
const other = all.filter((p) => !p.data.featured);
---

<Base
  title="Projects — Gioia Zheng"
  description="Retrieval, reranking, grounded generation, evaluation."
  width="wide"
>
  <div class="page-header">
    <h1>Projects</h1>
    <p class="page-tagline">
      Same template across every entry &mdash; problem, what I built, technical
      components, evidence, status, limitations &mdash; so it's clear what's
      claimed and what isn't.
    </p>
  </div>

  <h2>Featured</h2>
  {
    featured.map((p) => (
      <ProjectCard
        href={`/projects/${p.slug}/`}
        title={p.data.title}
        summary={p.data.summary}
        status={p.data.status}
        tags={p.data.tags}
        updated={p.data.last_updated}
        featured
      />
    ))
  }

  <h2>Other work</h2>
  <div class="card-grid two-col">
    {
      other.map((p) => (
        <ProjectCard
          href={`/projects/${p.slug}/`}
          title={p.data.title}
          summary={p.data.summary}
          status={p.data.status}
          tags={p.data.tags}
          updated={p.data.last_updated}
        />
      ))
    }
  </div>
</Base>
