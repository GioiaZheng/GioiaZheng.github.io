---
import { getCollection } from "astro:content";
import Base from "../../layouts/Base.astro";
import ProjectCard from "../../components/ProjectCard.astro";

const all = (await getCollection("projects")).sort(
  (a, b) => a.data.order - b.data.order,
);
const featured = all.filter((p) => p.data.featured);
const other = all.filter((p) => !p.data.featured);
---

<Base
  title="Projects — Gioia Zheng"
  description="Retrieval, reranking, grounded generation, evaluation."
  width="wide"
>
  <div class="page-header">
    <h1>Projects</h1>
    <p class="page-tagline">
      Selected systems and implementation projects, with emphasis on
      reproducibility, evaluation, and technical evidence.
    </p>
  </div>

  {
    featured.length > 0 && (
      <section class="section">
        <div class="kicker">
          <span>Featured</span>
          <span>{featured.length} project{featured.length > 1 ? "s" : ""}</span>
        </div>
        {featured.map((p) => (
          <ProjectCard
            href={`/projects/${p.slug}/`}
            title={p.data.title}
            summary={p.data.summary}
            status={p.data.status}
            tags={p.data.tags}
            updated={p.data.last_updated}
            featured
          />
        ))}
      </section>
    )
  }

  {
    other.length > 0 && (
      <section class="section">
        <div class="kicker">
          <span>Other work</span>
          <span>{other.length} entries</span>
        </div>
        <div class="card-grid two-col">
          {other.map((p) => (
            <ProjectCard
              href={`/projects/${p.slug}/`}
              title={p.data.title}
              summary={p.data.summary}
              status={p.data.status}
              tags={p.data.tags}
              updated={p.data.last_updated}
            />
          ))}
        </div>
        <p class="section-caption">
          <span>
            Older systems and coursework &mdash; listed for completeness, not as
            representative of current research focus.
          </span>
        </p>
      </section>
    )
  }
</Base>
