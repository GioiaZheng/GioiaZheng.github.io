---
import { getCollection } from "astro:content";
import Base from "../../layouts/Base.astro";
import ProjectCard from "../../components/ProjectCard.astro";
import { entrySlug } from "../../lib/content";

const all = (await getCollection("projects")).sort(
  (a, b) => a.data.order - b.data.order,
);
const featured = all.filter((p) => p.data.featured);
const related = all.filter((p) => !p.data.featured && p.data.academic);
---

<Base
  title="Projects — Gioia Zheng"
  description="Retrieval, grounded generation, agent evaluation, and reproducible machine learning."
  width="wide"
>
  <div class="page-header">
    <h1>Projects</h1>
    <p class="page-tagline">
      Research artifacts and controlled experiments in retrieval, grounded
      generation, agent evaluation, failure analysis, and reproducible machine learning.
    </p>
  </div>

  {
    featured.length > 0 && (
      <section class="section">
        <div class="kicker">
          <span>Featured</span>
          <span>{featured.length} project{featured.length > 1 ? "s" : ""}</span>
        </div>
        {featured.map((p) => (
          <ProjectCard
            href={`/projects/${entrySlug(p)}/`}
            title={p.data.title}
            summary={p.data.summary}
            status={p.data.status}
            tags={p.data.tags}
            updated={p.data.last_updated}
            featured
          />
        ))}
      </section>
    )
  }

  {
    related.length > 0 && (
      <section class="section">
        <div class="kicker">
          <span>Related research</span>
          <span>{related.length} project{related.length > 1 ? "s" : ""}</span>
        </div>
        <div class="card-grid two-col">
          {related.map((p) => (
            <ProjectCard
              href={`/projects/${entrySlug(p)}/`}
              title={p.data.title}
              summary={p.data.summary}
              status={p.data.status}
              tags={p.data.tags}
              updated={p.data.last_updated}
            />
          ))}
        </div>
      </section>
    )
  }
</Base>
