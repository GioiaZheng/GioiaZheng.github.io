---
import Base from "../layouts/Base.astro";
---

<Base
  title="Research materials - Gioia Zheng"
  description="One-page CV, research interests, and selected projects portfolio for research and graduate applications."
  width="wide"
>
  <div class="page-header">
    <p class="hero-eyebrow">Application materials</p>
    <h1>Research materials</h1>
    <p class="page-tagline">
      Concise, evidence-backed documents for M.Sc., HiWi, research assistant,
      and research engineering applications.
    </p>
  </div>

  <div class="card-grid two-col">
    <a href="/cv/Gioia_Zheng_cv.pdf" class="card">
      <div class="card-head">
        <div class="card-title">One-page CV</div>
        <span class="badge" data-status="published">PDF</span>
      </div>
      <p class="card-summary">
        Education, completed experience, selected projects, merged open-source
        contributions, and technical methods.
      </p>
      <div class="card-action">Open CV</div>
    </a>

    <a href="/research/Gioia_Zheng_research_interests.pdf" class="card">
      <div class="card-head">
        <div class="card-title">Research Interests</div>
        <span class="badge" data-status="published">1 page</span>
      </div>
      <p class="card-summary">
        Information Retrieval, RAG/LLM Evaluation, Reproducible ML Systems, and
        Reinforcement Learning for game and embodied agents.
      </p>
      <div class="card-action">Open statement</div>
    </a>

    <a href="/research/Gioia_Zheng_projects_portfolio.pdf" class="card">
      <div class="card-head">
        <div class="card-title">Projects Portfolio</div>
        <span class="badge" data-status="published">2 pages</span>
      </div>
      <p class="card-summary">
        RAG Observatory, CiboCompass, client systems delivery, and merged MTEB
        contributions with explicit evidence boundaries.
      </p>
      <div class="card-action">Open portfolio</div>
    </a>

    <div class="card">
      <div class="card-head">
        <div class="card-title">Evidence policy</div>
      </div>
      <p class="card-summary">
        These documents use completed, verifiable work. Planned studies are
        labelled as planned; open pull requests and unsupported claims are
        excluded.
      </p>
    </div>
  </div>
</Base>
