---
import { getCollection } from "astro:content";
import Base from "../layouts/Base.astro";
import ProjectCard from "../components/ProjectCard.astro";

const featured = (await getCollection("projects"))
  .filter((p) => p.data.featured)
  .sort((a, b) => a.data.order - b.data.order);

const writing = (await getCollection("writing"))
  .filter((w) => w.data.status === "published")
  .sort((a, b) => (b.data.date ?? "").localeCompare(a.data.date ?? ""));
---

<Base
  title="Gioia Zheng — RAG, evaluation, reproducible ML"
  description="I build retrieve → rerank → generate pipelines and the evaluation machinery around them — on a single-laptop CPU budget."
  width="medium"
>
  <section class="hero">
    <h1>Gioia Zheng</h1>
    <p class="hero-tagline">
      RAG Systems &middot; Reranking &middot; Grounding Evaluation &middot; CPU-Constrained ML
    </p>
    <p class="hero-positioning">
      I build retrieve&nbsp;&rarr;&nbsp;rerank&nbsp;&rarr;&nbsp;generate pipelines and the
      evaluation machinery that tells you whether they actually work. Current
      focus: paired-bootstrap CIs, NLI grounding scores, and reproducibility
      manifests on a single-laptop CPU budget.
    </p>

    <div class="hero-actions">
      {
        featured[0] && (
          <a href={`/projects/${featured[0].slug}/`} class="btn btn-primary">
            Featured project &rarr;
          </a>
        )
      }
      <a href="https://github.com/GioiaZheng" class="btn">GitHub &rarr;</a>
    </div>
    <p class="hero-secondary">
      <a href="/cv/Zheng_Gioia_cv.pdf">Resume / CV (PDF)</a>
    </p>
  </section>

  <h2>Featured</h2>
  {
    featured.map((p) => (
      <ProjectCard
        href={`/projects/${p.slug}/`}
        title={p.data.title}
        summary={p.data.summary}
        status={p.data.status}
        tags={p.data.tags}
        updated={p.data.last_updated}
        featured
      />
    ))
  }
  <p class="muted" style="margin-top: 1rem;">
    See <a href="/projects/">all projects</a> for older systems and coursework.
  </p>

  {
    writing.length > 0 && (
      <>
        <h2>Recent writing</h2>
        <div class="card-grid">
          {writing.slice(0, 2).map((w) => (
            <a href={`/writing/${w.slug}/`} class="card">
              <div class="card-head">
                <div class="card-title">{w.data.title}</div>
              </div>
              <p class="card-summary">{w.data.summary}</p>
              {w.data.date && (
                <div class="card-meta">
                  <span>{w.data.date}</span>
                </div>
              )}
            </a>
          ))}
        </div>
      </>
    )
  }
</Base>
