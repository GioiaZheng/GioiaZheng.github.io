---
import { getCollection } from "astro:content";
import Base from "../layouts/Base.astro";
import { entrySlug } from "../lib/content";

const featured = (await getCollection("projects"))
  .filter((p) => p.data.featured)
  .sort((a, b) => a.data.order - b.data.order);
const anchor = featured[0];

const writing = (await getCollection("writing"))
  .filter((w) => w.data.status === "published")
  .sort((a, b) => (b.data.date ?? "").localeCompare(a.data.date ?? ""));
const recent = writing[0];
---

<Base
  title="Gioia Zheng — retrieval, evaluation, AI infrastructure"
  description="B.Sc. student in Applied Computer Science and Artificial Intelligence building reproducible retrieval and evaluation systems for large-scale QA pipelines."
  width="wide"
>
  <section class="hero">
    <div class="hero-text">
      <p class="hero-eyebrow">Retrieval systems · evaluation · automation</p>
      <h1>Gioia Zheng</h1>
      <p class="hero-tagline">
        Information Retrieval &middot; RAG Evaluation &middot; Reproducible ML &middot; AI Infrastructure
      </p>
      <p class="hero-positioning">
        B.Sc. student at Sapienza University of Rome building reproducible
        retrieve&nbsp;→&nbsp;rerank&nbsp;→&nbsp;generate systems and the
        evaluation machinery around large-scale QA pipelines.
      </p>
      <div class="hero-actions">
        {
          anchor && (
            <a href={`/projects/${entrySlug(anchor)}/`} class="btn btn-primary">
              Featured project
            </a>
          )
        }
        <a href="/contact/" class="btn">Contact me</a>
      </div>
    </div>

    <aside class="focus-panel" aria-label="Current focus">
      <div class="focus-panel-label">Currently</div>

      <div class="focus-item">
        <div class="focus-item-head">Focus</div>
        <div class="focus-item-body">
          Research-engineering problems at the intersection of information
          retrieval, evaluation methodology, and AI infrastructure.
        </div>
      </div>

      <div class="focus-item">
        <div class="focus-item-head">Methods</div>
        <div class="focus-item-body">
          BM25, dense retrieval, FAISS, cross-encoder reranking, T5 generation,
          paired evaluation, reproducibility manifests, WordPress, and n8n
          automation.
        </div>
      </div>

      <div class="focus-item">
        <div class="focus-item-head">Experience</div>
        <div class="focus-item-body">
          Production PHP / WordPress development at Idearia, automation
          workflows with n8n, and retrieval-augmented QA experimentation over
          MS MARCO.
        </div>
      </div>
    </aside>

    <ul class="hero-spec" aria-label="At a glance">
      <li><span class="hero-spec-k">LOC</span> Rome, IT</li>
      <li><span class="hero-spec-k">EDU</span> B.Sc. ACSAI · Sapienza</li>
      <li><span class="hero-spec-k">DOMAIN</span> IR · RAG evaluation · reproducible ML</li>
      <li><span class="hero-spec-k">CODE</span> open source</li>
    </ul>
  </section>

  {
    anchor && (
      <section class="section">
        <div class="kicker">
          <span>Featured project</span>
          <a href="/projects/">All projects</a>
        </div>

        <a href={`/projects/${entrySlug(anchor)}/`} class="card card-featured">
          <div class="card-head">
            <div class="card-title">{anchor.data.title}</div>
            <span class="badge" data-status={anchor.data.status}>
              {anchor.data.status}
            </span>
          </div>
          <p class="card-summary">{anchor.data.summary}</p>

          <div class="card-tags">
            {anchor.data.tags.map((t) => (
              <span class="card-tag">{t}</span>
            ))}
          </div>

          <div class="card-metrics" aria-label="Headline numbers">
            <div class="card-metric-row">
              <span class="card-metric-label">Token-F1</span>
              <span class="card-metric-value">Δ +0.171</span>
            </div>
            <div class="card-metric-row">
              <span class="card-metric-label">95% CI</span>
              <span class="card-metric-value">[+0.163, +0.178]</span>
            </div>
            <div class="card-metric-row">
              <span class="card-metric-label">Queries</span>
              <span class="card-metric-value">6,980 paired</span>
            </div>
          </div>

          <div class="card-meta">
            {anchor.data.last_updated && <span>updated {anchor.data.last_updated}</span>}
            <span class="card-meta-sep">·</span>
            <span class="card-action">View project</span>
          </div>
        </a>
      </section>
    )
  }

  {
    recent && (
      <section class="section">
        <div class="kicker">
          <span>Recent writing</span>
          {writing.length > 1 && <a href="/writing/">All notes</a>}
        </div>

        <a href={`/writing/${entrySlug(recent)}/`} class="card">
          <div class="card-head">
            <div class="card-title">{recent.data.title}</div>
            {recent.data.date && (
              <span class="badge" data-status="published">
                {recent.data.date}
              </span>
            )}
          </div>
          <p class="card-summary">{recent.data.summary}</p>
          <div class="card-action">Read note</div>
        </a>
      </section>
    )
  }
</Base>
