---
import { getCollection } from "astro:content";
import Base from "../layouts/Base.astro";

const featured = (await getCollection("projects"))
  .filter((p) => p.data.featured)
  .sort((a, b) => a.data.order - b.data.order);
const anchor = featured[0];

const writing = (await getCollection("writing"))
  .filter((w) => w.data.status === "published")
  .sort((a, b) => (b.data.date ?? "").localeCompare(a.data.date ?? ""));
const recent = writing[0];
---

<Base
  title="Gioia Zheng — RAG, evaluation, reproducible ML"
  description="I build retrieve → rerank → generate pipelines and the evaluation machinery around them — on a single-laptop CPU budget."
  width="medium"
>
  <!-- HERO -->
  <section class="hero">
    <div class="hero-text">
      <h1>Gioia Zheng</h1>
      <p class="hero-tagline">
        RAG &middot; Reranking &middot; Grounding Evaluation &middot; CPU-Constrained ML
      </p>
      <p class="hero-positioning">
        I build retrieve&nbsp;&rarr;&nbsp;rerank&nbsp;&rarr;&nbsp;generate
        pipelines and the evaluation machinery that tells you whether they
        actually work.
      </p>
      <div class="hero-actions">
        {
          anchor && (
            <a href={`/projects/${anchor.slug}/`} class="btn btn-primary">
              Featured project &rarr;
            </a>
          )
        }
        <a href="https://github.com/GioiaZheng" class="btn">GitHub &rarr;</a>
      </div>
      <p class="hero-secondary">
        <a href="/cv/Zheng_Gioia_cv.pdf">Resume / CV (PDF)</a>
      </p>
    </div>

    <aside class="focus-panel" aria-label="Current focus">
      <div class="focus-panel-label">Currently</div>

      <div class="focus-item">
        <div class="focus-item-head">Focus</div>
        <div class="focus-item-body">
          Rerank-vs-grounding mismatch on a fixed seq2seq generator &mdash; when
          surface metrics rise while NLI-based grounding regresses.
        </div>
      </div>

      <div class="focus-item">
        <div class="focus-item-head">Methods</div>
        <div class="focus-item-body">
          Paired bootstrap CIs · NLI entailment grounding · schema-v2
          reproducibility manifests.
        </div>
      </div>

      <div class="focus-item">
        <div class="focus-item-head">Constraint</div>
        <div class="focus-item-body">CPU-only, single-machine.</div>
      </div>
    </aside>
  </section>

  <!-- FEATURED PROJECT -->
  {
    anchor && (
      <section class="section">
        <div class="kicker">
          <span>Featured project</span>
          <a href="/projects/">All projects &rarr;</a>
        </div>

        <a href={`/projects/${anchor.slug}/`} class="card card-featured">
          <div class="card-head">
            <div class="card-title">{anchor.data.title}</div>
            <span class="badge" data-status={anchor.data.status}>
              {anchor.data.status}
            </span>
          </div>
          <p class="card-summary">{anchor.data.summary}</p>

          <div class="card-tags">
            {anchor.data.tags.map((t) => (
              <span class="card-tag">{t}</span>
            ))}
          </div>

          <div class="card-metrics" aria-label="Headline numbers">
            <div class="card-metric-row">
              <span class="card-metric-label">Token-F1</span>
              <span class="card-metric-value">Δ +0.171</span>
            </div>
            <div class="card-metric-row">
              <span class="card-metric-label">95% CI</span>
              <span class="card-metric-value">[+0.163, +0.178]</span>
            </div>
            <div class="card-metric-row">
              <span class="card-metric-label">Queries</span>
              <span class="card-metric-value">6,980 paired</span>
            </div>
          </div>

          <div class="card-meta">
            {anchor.data.last_updated && <span>updated {anchor.data.last_updated}</span>}
            <span class="card-meta-sep">·</span>
            <span class="card-action">View project →</span>
          </div>
        </a>
      </section>
    )
  }

  <!-- WRITING -->
  {
    recent && (
      <section class="section">
        <div class="kicker">
          <span>Recent writing</span>
          {writing.length > 1 && <a href="/writing/">All notes &rarr;</a>}
        </div>

        <a href={`/writing/${recent.slug}/`} class="card">
          <div class="card-head">
            <div class="card-title">{recent.data.title}</div>
            {recent.data.date && (
              <span class="badge" data-status="published">
                {recent.data.date}
              </span>
            )}
          </div>
          <p class="card-summary">{recent.data.summary}</p>
          <div class="card-action">Read note &rarr;</div>
        </a>
      </section>
    )
  }
</Base>
