---
import { getCollection } from "astro:content";
import Base from "../layouts/Base.astro";
import { entrySlug } from "../lib/content";

const featured = (await getCollection("projects"))
  .filter((p) => p.data.featured)
  .sort((a, b) => a.data.order - b.data.order);
const anchor =
  featured.find((project) => entrySlug(project) === "rag-observatory") ??
  featured[0];

const writing = (await getCollection("writing"))
  .filter((w) => w.data.status === "published")
  .sort((a, b) => (b.data.date ?? "").localeCompare(a.data.date ?? ""));
const recent = writing[0];
---

<Base
  title="Gioia Zheng — information retrieval and RAG evaluation"
  description="B.Sc. student in Applied Computer Science and Artificial Intelligence studying retrieval-augmented generation, evaluation methodology, and reproducible ML."
  width="wide"
>
  <section class="hero">
    <div class="hero-text">
      <p class="hero-eyebrow">Information retrieval · RAG evaluation · reproducible ML</p>
      <h1>Gioia Zheng</h1>
      <p class="hero-tagline">
        Retrieval Diagnostics &middot; RAG Evaluation &middot; Failure Analysis &middot; Reproducible ML
      </p>
      <p class="hero-positioning">
        I study where retrieval-augmented generation fails, how retrieval and
        generation errors interact, and how evaluation can make those failures
        measurable. I build reproducible systems to turn these questions into
        testable evidence.
      </p>
      <div class="hero-actions">
        {
          anchor && (
            <a href={`/projects/${entrySlug(anchor)}/`} class="btn btn-primary">
              Featured research project
            </a>
          )
        }
        <a href="/materials/" class="btn">Research materials</a>
        <a href="/contact/" class="btn">Contact me</a>
      </div>
    </div>

    <aside class="focus-panel" aria-label="Current focus">
      <div class="focus-panel-label">Research focus</div>

      <div class="focus-item">
        <div class="focus-item-head">Questions</div>
        <div class="focus-item-body">
          When does better retrieval improve grounded generation, and when do
          aggregate metrics hide important failure modes?
        </div>
      </div>

      <div class="focus-item">
        <div class="focus-item-head">Methods</div>
        <div class="focus-item-body">
          BM25, dense retrieval, FAISS, cross-encoder reranking, T5 generation,
          controlled ablations, paired bootstrap, grounding evaluation, and
          reproducibility manifests.
        </div>
      </div>

      <div class="focus-item">
        <div class="focus-item-head">Current study</div>
        <div class="focus-item-body">
          Testing how retrieval depth and chunk boundaries change evidence
          coverage and failure labels on public SciFact traces.
        </div>
      </div>
    </aside>

    <ul class="hero-spec" aria-label="At a glance">
      <li><span class="hero-spec-k">LOC</span> Rome, IT</li>
      <li><span class="hero-spec-k">EDU</span> B.Sc. ACSAI · Sapienza</li>
      <li><span class="hero-spec-k">DOMAIN</span> IR · RAG evaluation · reproducible ML</li>
      <li><span class="hero-spec-k">CODE</span> open source</li>
    </ul>
  </section>

  {
    anchor && (
      <section class="section">
        <div class="kicker">
          <span>Featured research project</span>
          <a href="/projects/">All projects</a>
        </div>

        <a href={`/projects/${entrySlug(anchor)}/`} class="card card-featured">
          <div class="card-head">
            <div class="card-title">{anchor.data.title}</div>
            <span class="badge" data-status={anchor.data.status}>
              {anchor.data.status}
            </span>
          </div>
          <p class="card-summary">{anchor.data.summary}</p>

          <div class="card-tags">
            {anchor.data.tags.map((t) => (
              <span class="card-tag">{t}</span>
            ))}
          </div>

          <div class="card-metrics" aria-label="Headline numbers">
            <div class="card-metric-row">
              <span class="card-metric-label">Real traces</span>
              <span class="card-metric-value">40 SciFact</span>
            </div>
            <div class="card-metric-row">
              <span class="card-metric-label">Controlled queries</span>
              <span class="card-metric-value">20 fixed</span>
            </div>
            <div class="card-metric-row">
              <span class="card-metric-label">Automated tests</span>
              <span class="card-metric-value">107</span>
            </div>
          </div>

          <div class="card-meta">
            {anchor.data.last_updated && <span>updated {anchor.data.last_updated}</span>}
            <span class="card-meta-sep">·</span>
            <span class="card-action">View project</span>
          </div>
        </a>
      </section>
    )
  }

  {
    recent && (
      <section class="section">
        <div class="kicker">
          <span>Recent writing</span>
          {writing.length > 1 && <a href="/writing/">All notes</a>}
        </div>

        <a href={`/writing/${entrySlug(recent)}/`} class="card">
          <div class="card-head">
            <div class="card-title">{recent.data.title}</div>
            {recent.data.date && (
              <span class="badge" data-status="published">
                {recent.data.date}
              </span>
            )}
          </div>
          <p class="card-summary">{recent.data.summary}</p>
          <div class="card-action">Read note</div>
        </a>
      </section>
    )
  }
</Base>
