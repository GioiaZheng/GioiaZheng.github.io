---
const year = new Date().getFullYear();
const buildDate = new Date().toISOString().slice(0, 10);
let commit = "local";
try {
  const { execSync } = await import("node:child_process");
  commit = execSync("git rev-parse --short HEAD", { encoding: "utf-8" }).trim();
} catch {
  /* no git context */
}
---

<footer class="site-footer">
  <div class="site-footer-inner">
    <div class="site-footer-line">
      <span>© {year} Gioia Zheng</span>
      <span class="site-footer-sep">·</span>
      <a href="mailto:gioia.zheng.stud@gmail.com">Email</a>
      <span class="site-footer-sep">·</span>
      <a href="https://www.linkedin.com/in/gioia-zheng-9233a0303">LinkedIn</a>
      <span class="site-footer-sep">·</span>
      <a href="https://github.com/GioiaZheng">GitHub</a>
      <span class="site-footer-sep">·</span>
      <a href="/cv/Gioia_Zheng_cv.pdf">Resume</a>
    </div>
    <div class="site-footer-build">
      Build: <code>{commit}</code> · {buildDate}
    </div>
  </div>
</footer>
